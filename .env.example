# MySQL Configuration
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=stocks_db
MYSQL_USER=stocks_user
MYSQL_PASSWORD=stocks_password

# Redis Configuration (defaults in docker-compose)
REDIS_HOST=redis
REDIS_PORT=6379

# App Configuration
DEBUG=False
LOG_LEVEL=INFO

# Dashboard password (required for docker compose auth)
STOCKSPIKES_PWD=changeme

# Alpaca market data (live quotes for Stocks table)
ALPACA_API_KEY=
ALPACA_API_SECRET=
# iex | sip | overnight | auto (iex by day, overnight late night ET)
ALPACA_DATA_FEED=auto
